#!/bin/bash
# Test double for gh. Records calls under $FAKE_GH_DIR. Dev only; never packaged.
d=${FAKE_GH_DIR:?}; mkdir -p "$d"
args=(); while [ $# -gt 0 ]; do if [ "$1" = --body-file ]; then args+=(--body "$(cat "$2")"); shift 2; else args+=("$1"); shift; fi; done; set -- "${args[@]}"  # a text in a file reads as --body TEXT
echo "$*" >> "$d/calls.log"
here=$(cd "$(dirname "$0")" && pwd)
case "$1 $2" in
  "api "*) exec python3 "$here/fake.py" "$@";;
  "repo view") exec python3 "$here/fake.py" "$@";;
  "auth status") [ -n "${FAKE_GH_OFFLINE:-}" ] && { echo "not logged in" >&2; exit 1; }; echo "Logged in";;
  "label create"|"label list") exec python3 "$here/fake.py" "$@";;
  "issue list"|"issue create") [[ "$*" == *"--label health"* || "$*" == *"--label feature:"* || "$*" == *"--milestone"* || "$*" == *"--repo "* || "$*" == *"number,title,milestone"* ]] && exec python3 "$here/fake.py" "$@";;
  "issue view") [ -f "$d/issues.json" ] && exec python3 "$here/fake.py" "$@";;
  "issue edit"|"issue close"|"issue reopen"|"issue comment"|"pr edit") [ -f "$d/issues.json" ] || [ "$1" = pr ] && exec python3 "$here/fake.py" "$@";;
esac
case "$1 $2" in
  "pr create") head=""; body=""; while [ $# -gt 0 ]; do [ "$1" = --head ] && head=$2; [ "$1" = --body ] && body=$2; shift; done
     n=$(( $(ls "$d"/pr-[0-9]* 2>/dev/null | wc -l) + 1 )); echo "$head" > "$d/pr-$n"; printf '%s\n' "$body" > "$d/body-$n"
     echo "https://example.test/pull/$n";;
  "pr view") n=${3##*/}; v="FAKE_GH_PR_STATE_$n"; [ -n "${!v:-}" ] && { echo "{\"state\": \"${!v}\"}"; exit 0; }
     [ -n "${FAKE_GH_PR_STATE:-}" ] && { echo "{\"state\": \"$FAKE_GH_PR_STATE\"${FAKE_GH_PR_HEAD:+, \"headRefOid\": \"$FAKE_GH_PR_HEAD\"}}"; exit 0; }
     echo "no pull requests found" >&2; exit 1;;
  "pr merge") [ -n "${FAKE_GH_MERGE_FAIL:-}" ] && { echo "merge refused" >&2; exit 1; }
     if [ -n "${FAKE_GH_REQUIRE:-}" ]; then  # a branch rule: every required context needs a success status on the PR head
       for c in ${FAKE_GH_REQUIRE//,/ }; do
         grep -q "\"sha\": \"${FAKE_GH_PR_HEAD:-}\", \"context\": \"$c\", \"state\": \"success\"" "$d/statuses.log" 2>/dev/null \
           || { echo "required status check $c is expected" >&2; exit 1; }
       done
     fi

     if [ -n "${FAKE_GH_MERGE_BRANCH:-}" ]; then  # really merge the branch into origin/main
       t=$(mktemp -d); git clone -q "$FAKE_GH_ORIGIN" "$t" && ( cd "$t" && git config user.email t@example.test && git config user.name Toy \
         && git merge -q --no-edit "origin/$FAKE_GH_MERGE_BRANCH" && git push -q origin HEAD:main ); rm -rf "$t"
     fi; echo "merged";;
  "release create") [ -n "${FAKE_GH_RELEASE_FAIL:-}" ] && { echo "release refused" >&2; exit 1; }
     while [ $# -gt 0 ]; do [ "$1" = --notes-file ] && cat "$2" >> "$d/notes.log"; shift; done
     echo "https://example.test/releases/draft";;
  "release view") [[ "$*" == *"--json tagName"* ]] && { [ -n "${FAKE_GH_LATEST_TAG:-}" ] && { echo "$FAKE_GH_LATEST_TAG"; exit 0; }; echo "release not found" >&2; exit 1; }
     grep -qx "$3" "$d/releases" 2>/dev/null && exit 0; echo "release not found" >&2; exit 1;;
  "release download") [[ "$*" == *"--archive zip"* ]] || exit 1; dir=.; while [ $# -gt 0 ]; do [ "$1" = --dir ] && dir=$2; shift; done
     [ -f "${FAKE_GH_ARCHIVE:-}" ] || { echo "release not found" >&2; exit 1; }; cp "$FAKE_GH_ARCHIVE" "$dir/";;
  "auth token") [ -n "${FAKE_GH_NO_AUTH:-}" ] && { echo "not logged in" >&2; exit 1; }; echo "fake-token";;
  "pr list") echo "[]";;
  "issue list") python3 -c '
import datetime, json, os
state = "OPEN" if os.environ.get("FAKE_GH_ISSUE_OPEN") else "CLOSED" if os.environ.get("FAKE_GH_ISSUE_CLOSED") else ""
day = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
notes = [{"body": "Failing on %s." % day}] if os.environ.get("FAKE_GH_ISSUE_COMMENTED") else []
mark = "<!-- loop-regression flag placed=Alpha -->" if os.environ.get("FAKE_GH_ISSUE_PLACED") else "<!-- loop-regression flag -->"
print(json.dumps([{"number": 7, "state": state, "body": mark, "comments": notes}] if state else []))
';;
  "issue create") echo "https://example.test/issues/7";;
  *) exit 0;;
esac
