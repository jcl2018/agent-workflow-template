{
  "base": "main",
  "checks": [
    "bash dev/toy/test-docs.sh",
    "bash dev/toy/test-release.sh",
    "bash dev/toy/test-goal.sh",
    "bash dev/toy/test-regression.sh",
    "python3 dev/package.py --out dist/check.zip",
    "bash dev/test-package.sh"
  ],
  "agent_command": [
    "claude",
    "-p",
    "--model=sonnet",
    "--allowedTools=Bash,Read,Write,Edit,Skill"
  ],
  "judge_command": [
    "claude",
    "-p",
    "--tools",
    ""
  ],
  "parallel": 3,
  "risky_paths": [
    "^\\.github/",
    "(^|/)auth",
    "(^|/)migrations?/",
    "(^|/)(schema|data)\\b"
  ],
  "version_file": "VERSION",
  "wiki_dir": "docs/wiki",
  "pr_bumps_version": false,
  "mend": true,
  "resume_on_limit": false
}
