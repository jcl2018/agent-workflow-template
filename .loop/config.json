{
  "base": "main",
  "agent_command": [
    "claude",
    "-p",
    "--model=sonnet",
    "--allowedTools=Bash,Read,Write,Edit,Skill"
  ],
  "judge_command": [
    "claude",
    "-p",
    "--tools",
    ""
  ],
  "parallel": 0,
  "risky_paths": [
    "^\\.github/",
    "(^|/)auth",
    "(^|/)migrations?/",
    "(^|/)(schema|data)\\b"
  ],
  "version_file": "VERSION",
  "wiki_dir": "docs/wiki",
  "pr_bumps_version": false,
  "mend": true,
  "resume_on_limit": false,
  "criteria": true,
  "criteria_max": 6,
  "auto_approve": true,
  "auto_merge": true,
  "regression_cron": "17 */4 * * *",
  "health_cron": "47 */4 * * *",
  "judge_env": "ANTHROPIC_API_KEY",
  "judge_setup": "",
  "digest_owner": "",
  "routines": [],
  "time_budget_minutes": 120,
  "token_budget": 3000000,
  "review_depth": "full",
  "_help": {
    "review_depth": "full runs the plan and review skills' whole pipeline and refuses a condensed one; condensed allows a shorter run."
  }
}
